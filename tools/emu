#!/usr/bin/env bash
# Emulators for UI work (§6.5's emulator layer): a 45 mm Pixel Watch 4 and a
# Pixel 8. Plumbing, permissions and layout — and, through `replay`, the matcher
# as the watch actually shows it: a stored activity is played into the recorder
# in place of the Wear synthetic provider, whose one default route with identical
# values every run can never find anything. `bundle` puts the routes there first,
# because the two emulators are not paired and the Data Layer cannot.
#
# A replay writes no session and uploads nothing, so nothing it does can reach
# the phone's history.
set -euo pipefail

export ANDROID_HOME="${ANDROID_HOME:-/usr/local/android-sdk}"
export PATH="$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$PATH"

WATCH=emulator-5554
PHONE=emulator-5556
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

boot() { # avd serial
  if adb devices | grep -q "^$2[[:space:]]*device"; then echo "$1: already up"; return; fi
  echo "$1: booting…"
  # -port pins the serial. Without it the emulator takes the lowest free console
  # port, so which AVD is 5554 depends on boot order — and a push meant for the
  # phone silently lands on the watch.
  #
  # setsid, not `nohup ... &`: the emulator must outlive this shell, and a plain
  # background job dies with its parent's process group when the task ends.
  setsid -f emulator -avd "$1" -port "${2##*-}" -no-boot-anim -gpu host \
    >/dev/null 2>&1 </dev/null
  until [ "$(adb -s "$2" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; do sleep 5; done
  echo "$1: up on $2"
}

# Cheap insurance against the above ever being wrong again: the watch image
# reports "watch" in ro.build.characteristics and the phone image does not.
assert_watch() {
  local w
  w=$(adb -s "$WATCH" shell getprop ro.build.characteristics 2>/dev/null | tr -d '\r')
  case "$w" in *watch*) ;; *) echo "error: $WATCH is not the watch ($w)" >&2; exit 1 ;; esac
}

assert_roles() {
  local p
  assert_watch
  p=$(adb -s "$PHONE" shell getprop ro.build.characteristics 2>/dev/null | tr -d '\r')
  case "$p" in *watch*) echo "error: $PHONE is the watch, not the phone" >&2; exit 1 ;; esac
}

# Copies a file into the watch app's own storage.
#
# `adb push` cannot write under /data/data, and `run-as` — which can, on a
# debuggable build — runs on the watch and cannot read this laptop's disk. So the
# bytes go through adb's stdin rather than via /data/local/tmp: an app cannot
# generally read that directory anyway, since SELinux labels it for the shell
# user and run-as drops into the app's own domain.
#
# The size is checked afterwards because the two ways this can go wrong are both
# silent — a truncated transfer, and an adb old enough to translate line endings
# in a stream, which would corrupt the gzipped bundle rather than fail.
push_private() { # <local file> <dest dir, relative to the app's home> <dest name>
  local want got
  want=$(stat -c %s "$1")
  adb -s "$WATCH" shell "run-as de.hecate sh -c 'mkdir -p $2 && cat > $2/$3'" < "$1" || {
    echo "error: run-as refused. Only a debuggable build can be written to — tools/emu install" >&2
    exit 1
  }
  got=$(adb -s "$WATCH" shell "run-as de.hecate stat -c %s $2/$3" 2>/dev/null | tr -d '\r')
  [ "$got" = "$want" ] || {
    echo "error: $3 arrived as $got bytes, not $want — not using it" >&2
    adb -s "$WATCH" shell "run-as de.hecate rm -f $2/$3" || true
    exit 1
  }
}

# Paths on this machine mean what they look like they mean; everything else goes
# through to :core:run untouched, whose working directory is the repository root.
absolutise() {
  local a out=()
  for a in "$@"; do
    if [ -e "$a" ]; then out+=("$(readlink -f "$a")"); else out+=("$a"); fi
  done
  printf '%s\n' "${out[*]-}"
}

# Granted here rather than tapped through: the runtime prompts are not what is
# being iterated on, and BODY_SENSORS/health.READ_HEART_RATE differ by platform
# version in a way that is easy to get wrong by hand.
grant() {
  for p in ACCESS_FINE_LOCATION ACCESS_COARSE_LOCATION ACCESS_BACKGROUND_LOCATION \
           BODY_SENSORS ACTIVITY_RECOGNITION POST_NOTIFICATIONS; do
    adb -s "$1" shell pm grant de.hecate "android.permission.$p" >/dev/null 2>&1 || true
  done
  adb -s "$1" shell pm grant de.hecate android.permission.health.READ_HEART_RATE >/dev/null 2>&1 || true
}

case "${1:-up}" in
  up)
    boot hecate_watch4 "$WATCH"
    boot hecate_pixel8 "$PHONE"
    ;;
  watch) boot hecate_watch4 "$WATCH" ;;
  phone) boot hecate_pixel8 "$PHONE" ;;

  install)
    assert_roles
    # -s explicitly: a real watch and phone are often attached over adb at the
    # same time, and a debug-signed APK over the release install there costs an
    # uninstall — which costs any session not yet uploaded (§6.3).
    ( cd "$ROOT" && ./gradlew :wear:assembleDebug :phone:assembleDebug )
    adb -s "$WATCH" install -r -t "$ROOT/wear/build/outputs/apk/debug/wear-debug.apk"
    adb -s "$PHONE" install -r -t "$ROOT/phone/build/outputs/apk/debug/phone-debug.apk"
    grant "$WATCH"; grant "$PHONE"
    adb -s "$WATCH" shell monkey -p de.hecate -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
    adb -s "$PHONE" shell monkey -p de.hecate -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
    echo "installed and launched on both"
    ;;

  run)   # synthetic exercise, so the Live page has something to render.
         #
         # All five types this app records are accepted by the synthetic
         # provider. Give it a few seconds after starting the recording: distance
         # and heart rate arrive first and positions follow, so a session stopped
         # too early is discarded as "ohne Messpunkte" — which is the recorder
         # behaving correctly, not a fault.
    case "${2:-RUNNING}" in
      RUNNING|WALKING|HIKING|BIKING|SKIING) ;;
      *) echo "error: unknown type ${2}. One of: RUNNING WALKING HIKING BIKING SKIING" >&2; exit 2 ;;
    esac
    adb -s "$WATCH" shell am broadcast -a whs.USE_SYNTHETIC_PROVIDERS com.google.android.wearable.healthservices >/dev/null
    adb -s "$WATCH" shell am broadcast -a "whs.synthetic.user.START_${2:-RUNNING}" com.google.android.wearable.healthservices >/dev/null
    echo "synthetic ${2:-RUNNING} started — start the recording on the watch"
    ;;
  pause) adb -s "$WATCH" shell am broadcast -a whs.AUTO_PAUSE_DETECTED com.google.android.wearable.healthservices >/dev/null ;;
  stop)  adb -s "$WATCH" shell am broadcast -a whs.synthetic.user.STOP_EXERCISE com.google.android.wearable.healthservices >/dev/null ;;

  push)  # a backup ZIP from the computer into the phone's Downloads, where the
         # app's Storage-Access-Framework picker (Einstellungen → Sicherung einlesen)
         # can open it. No storage permission is involved on either side.
    assert_roles
    [ -f "${2:-}" ] || { echo "usage: tools/emu push <archive.zip>" >&2; exit 2; }
    adb -s "$PHONE" push "$2" /sdcard/Download/
    echo "pushed — in the app: Einstellungen → Sicherung einlesen → ☰ → Downloads"
    ;;

  shot) # into build/, which .gitignore already covers — screenshots of a
        # restored backup are personal data and must not land in the tree.
    assert_roles
    mkdir -p "$ROOT/build/screenshots"
    out="$ROOT/build/screenshots/${2:-shot}"
    adb -s "$WATCH" exec-out screencap -p > "$out-watch.png"
    adb -s "$PHONE" exec-out screencap -p > "$out-phone.png"
    echo "wrote $out-watch.png $out-phone.png"
    ;;

  bundle) # a route bundle from this machine into the watch's own storage.
          #
          # On a wrist this arrives over the Data Layer from the phone and there
          # is nothing to do by hand. The emulators are not paired (§6.5), so the
          # bundle has to be put there, and without one every replay below can
          # only ever say "Noch keine Routen" — correctly.
    assert_watch
    [ -f "${2:-}" ] || { echo "usage: tools/emu bundle <bundle.json|bundle.json.gz>" >&2; exit 2; }
    src="$(readlink -f "$2")"
    gz="$src"
    # BundleStore reads one shape only, and `:core:run bundle --out` writes the
    # other, so anything that is not already gzip is gzipped on the way past.
    case "$src" in
      *.gz) ;;
      *) gz="$(mktemp -t hecate-bundle.XXXXXX)"; gzip -c "$src" > "$gz" ;;
    esac
    push_private "$gz" files route-bundle.json.gz
    [ "$gz" = "$src" ] || rm -f "$gz"
    # The parsed bundle is cached for the life of the process, so a running app
    # would go on using the old one.
    adb -s "$WATCH" shell am force-stop de.hecate
    echo "bundle installed on the watch; app stopped so it reads the new one"
    ;;

  replay) # play a stored activity into the recorder, in place of the sensors.
          #
          # This is the only way to see the matcher work on an emulator: the Wear
          # synthetic provider emits one default route with identical values every
          # run, so it can never match anything. What is on screen during a replay
          # is what would have been on the wrist that day — the decisions are the
          # matcher's own, and it is not told which of the two it is running in.
          #
          # That now includes the auto-stop (A.30): a recording that ends with a
          # drive home or twenty minutes on a sofa ends the replay where it would
          # have ended the workout, with the same reason on the screen. Use
          # `autostop --session <f>` on the laptop first if you want to know
          # which of the stored activities do that.
    shift || true
    case "${1:-}" in
      --list|-l)
        shift
        # Straight through to the harness, which knows what each session matches
        # and can therefore say which ones are worth watching.
        ( cd "$ROOT" && ./gradlew -q :core:run --args="sessions $(absolutise "$@")" )
        exit 0
        ;;
      --stop)
        adb -s "$WATCH" shell am broadcast -n de.hecate/de.hecate.wear.recorder.ReplayReceiver \
          -a de.hecate.wear.REPLAY_STOP >/dev/null
        echo "replay stopped"
        exit 0
        ;;
    esac

    archive=""; pos=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --archive) archive="$(readlink -f "${2:?--archive wants a backup ZIP}")"; shift 2 ;;
        *) pos+=("$1"); shift ;;
      esac
    done
    speed="${pos[1]:-10}"

    if [ -n "$archive" ]; then
      [ -n "${pos[0]:-}" ] || { echo "usage: tools/emu replay --archive <zip> <id> [speed]" >&2; exit 2; }
      # Into build/, which .gitignore covers: a session out of a real backup is
      # personal data and must not land in the tree — same rule as `shot`.
      session="$ROOT/build/replay/${pos[0]}.jsonl"
      mkdir -p "$(dirname "$session")"
      ( cd "$ROOT" && ./gradlew -q :core:run --args="extract --archive $archive --session ${pos[0]} --out $session" )
    else
      session="${pos[0]:-}"
      [ -f "$session" ] || {
        echo "usage: tools/emu replay <session.jsonl> [speed]" >&2
        echo "       tools/emu replay --archive <backup.zip> <id> [speed]" >&2
        echo "       tools/emu replay --list [--archive <zip> | --sessions <dir>] [--bundle <f>]" >&2
        exit 2
      }
      session="$(readlink -f "$session")"
    fi

    assert_watch
    adb -s "$WATCH" shell "run-as de.hecate ls files/route-bundle.json.gz" >/dev/null 2>&1 ||
      echo "note: no route bundle on the watch, so this will say \"Noch keine Routen\" throughout — tools/emu bundle <f>"
    push_private "$session" files/replay current.jsonl
    # The app must be in the foreground for its receiver to be allowed to start a
    # foreground service; a broadcast into a stopped app cannot. If this ever
    # fails anyway the replay stays armed, and starting any exercise on the watch
    # picks it up instead of recording.
    adb -s "$WATCH" shell monkey -p de.hecate -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
    sleep 2
    adb -s "$WATCH" shell am broadcast -n de.hecate/de.hecate.wear.recorder.ReplayReceiver \
      -a de.hecate.wear.REPLAY --es file current.jsonl --ef speed "$speed" >/dev/null
    echo "replaying $(basename "$session") at ×$speed — the Live page says Wiedergabe while it runs"
    echo "quiet? adb -s $WATCH logcat -s ReplayReceiver:* ReplayFeed:* RecorderService:*"
    ;;

  log)   adb -s "$WATCH" logcat -s Hecate:V AndroidRuntime:E ;;
  down)  adb -s "$WATCH" emu kill 2>/dev/null || true; adb -s "$PHONE" emu kill 2>/dev/null || true ;;

  *)
    cat >&2 <<'USAGE'
usage: tools/emu <command>

  up | watch | phone          boot the emulators
  install                     build and install both debug APKs, grant permissions
  run [TYPE]                  synthetic exercise (plumbing only; matches nothing)
  pause | stop                synthetic auto-pause / end
  bundle <bundle.json>        sideload a route bundle onto the watch
  replay --list [...]         list stored activities and what each one matches
  replay <session.jsonl> [speed]
  replay --archive <zip> <id> [speed]
                              play a stored activity into the recorder
  replay --stop               end a running replay
  push <archive.zip>          a backup into the phone's Downloads
  shot [prefix]               screenshot both, into build/
  log | down                  watch logcat / kill both emulators

  TYPE is one of RUNNING WALKING HIKING BIKING SKIING; speed defaults to 10.
USAGE
    exit 2
    ;;
esac
